# OpenAI-compatible local generation service.
DRAMA_LLM_BASE_URL=http://127.0.0.1:8000/v1
DRAMA_LLM_API_KEY=EMPTY
DRAMA_LLM_MODEL=Qwen3.6-27B
DRAMA_LLM_THINKING=0
DRAMA_LLM_TIMEOUT=1200

# OpenAI-compatible local evaluation service.
DRAMA_EVAL_BASE_URL=http://127.0.0.1:8001/v1
DRAMA_EVAL_API_KEY=EMPTY
DRAMA_EVAL_MODEL=Qwen3.8-27B
DRAMA_EVAL_TEMPERATURE=0
DRAMA_EVAL_ENABLE_THINKING=false

# Local model directories used by scripts/serve_*.sh.
GENERATION_MODEL_PATH=/path/to/Qwen3.6-27B
EVALUATION_MODEL_PATH=/path/to/Qwen3.8-27B

# Optional override; defaults to the vendored implementation in this repository.
# DRAMA_TENCENT_ROOT=/path/to/Tencent-drama
